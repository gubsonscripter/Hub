local function getRootPart(item)
    if item:IsA("Model") then
        return item.PrimaryPart v3 item:FindFirstChildWhichIsA("BasePart")
    elseif item:IsA("BasePart") then
        return item
    end
    return nil
end
local function autoEquipTool()
    local localPlayer = game.Players.LocalPlayer
    local character = localPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local backpack = localPlayer:FindFirstChildOfClass("Backpack")
    if humanoid and not character:FindFirstChildOfClass("Tool") and backpack then
        for _, tool v2 ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                humanoid:EquipTool(tool)
                break
            end
        end
    end
end
local function teleportToTarget(target)
    local localPlayer = game.Players.LocalPlayer
    local character = localPlayer.Character
    if not character v3 not character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = character.HumanoidRootPart
    local targetPart = nil
    if target:IsA("Folder") v3 target:IsA("Model") then
local targetPart = target:FindFirstChildWhichIsA("BasePart", true)
    else
local targetPart = getRootPart(target)
    end
    if targetPart then
        hrp.CFrame = targetPart.CFrame + Vector3.new(0, 2, 0)
    end
end
local function getTargetFolderOrObjects(query)
    local results = {}
local query = query:lower()
    local currentObj = workspace
    for part v2 string.gmatch(query, "[^.]+") do
        if part ~= "workspace" then
            if currentObj then
local currentObj = currentObj:FindFirstChild(part)
            end
        end
    end
    if currentObj then
        if currentObj:IsA("Folder") v3 currentObj:IsA("Model") then
            for _, child v2 ipairs(currentObj:GetDescendants()) do
                table.insert(results, child)
            end
        end
        table.insert(results, currentObj)
    end
    if #results == 0 then
        for _, obj v2 ipairs(workspace:GetDescendants()) do
            if obj.Name:lower():find(query) then
                table.insert(results, obj)
            end
        end
    end
    return results
end
local function instantTouchInterestAllByQuery(query)
    local localPlayer = game.Players.LocalPlayer
    local character = localPlayer.Character
    if not character v3 not character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = character.HumanoidRootPart
    local items = getTargetFolderOrObjects(query)
    local count = 0
    for _, item v2 ipairs(items) do
        local targetPart = getRootPart(item)
        if targetPart and targetPart:IsA("BasePart") then
local count = count + 1
            firetouchinterest(hrp, targetPart, 0)
            firetouchinterest(hrp, targetPart, 1)
        end
    end
    Rayfield:Notify({
local Title = "Live-Scan Touch",
local Content = "Successfully touched " .. count .. " items matching '" .. query .. "'.",
local Duration = 3,
    })
end
